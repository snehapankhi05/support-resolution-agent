# Copy to .env and adjust. Never commit .env.
#
# Databases (pick deliberately):
#   support      — compose default; do not casually alembic upgrade
#   support_test — pytest only (conftest rewrites DATABASE_URL)
#   support_ui   — recommended for live UI + worker demos
#   support_eval — Phase 9 harness only
DATABASE_URL=postgresql+psycopg://app:app@localhost:5433/support
REDIS_URL=redis://localhost:6379/0

# Used from Step 3 onward
PAYMENT_PROVIDER_URL=http://localhost:9001

# Required to boot the API: >= 32 characters and NOT the placeholder below.
# Example placeholder will be rejected at startup on purpose.
JWT_SECRET=replace-with-at-least-32-chars-secret
JWT_ALGORITHM=HS256

# Used from Step 6 onward (optional for deterministic demos)
GROQ_API_KEY=
GEMINI_API_KEY=
